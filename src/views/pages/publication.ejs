<!-- src/views/pages/publication.ejs -->
<% pageStyles = 'publication'; %>

<div class="journal-masthead">
    <div class="journal-masthead-inner">
        <nav class="journal-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
            <a href="/publications">Publications</a>
            <% if (publication.category) { %>
                <span aria-hidden="true">&rsaquo;</span> <span><%= publication.category %></span>
            <% } %>
        </nav>

        <span class="journal-type-badge"><%= details.article_type || 'Publication' %></span>
        <h1 class="journal-title"><%= publication.title %></h1>

        <% if (details.author_list && details.author_list.length) { %>
            <ul class="journal-authors" aria-label="Authors">
                <% details.author_list.forEach((author) => { %>
                    <li>
                        <span class="author-name"><%= author.name %></span>
                        <% if (author.affiliation) { %><span class="author-affiliation"><%= author.affiliation %></span><% } %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="journal-authors-plain"><%= publication.authors.join(', ') %></p>
        <% } %>
        <% if (details.corresponding_author) { %>
            <p class="journal-corresponding">Corresponding author: <%= details.corresponding_author %></p>
        <% } %>

        <div class="journal-meta-strip">
            <span><%= journalName %></span>
            <% if (details.volume) { %>
                <span class="meta-dot"></span>
                <span>Vol. <%= details.volume %><% if (details.issue) { %>, Issue <%= details.issue %><% } %></span>
            <% } %>
            <% if (details.pages) { %>
                <span class="meta-dot"></span>
                <span>pp. <%= details.pages %></span>
            <% } %>
            <span class="meta-dot"></span>
            <span>Published <%= publication.published_date %></span>
            <% if (details.doi) { %>
                <span class="meta-dot"></span>
                <a href="https://doi.org/<%= details.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '') %>" target="_blank" rel="noopener noreferrer" class="journal-doi">
                    DOI: <%= details.doi %>
                </a>
            <% } %>
        </div>
    </div>
</div>

<div class="publication-content-wrapper">
    <article class="publication-article" data-track-view data-post-id="<%= publication.id %>">
        <!-- Publication Stats -->
        <div class="publication-stats-bar">
            <div class="publication-stats">
                <span class="stat-item">
                    <span class="icon"><%- icon('eye') %></span>
                    <span class="count" id="viewCount"><%= publication.views || 0 %></span>
                    <span class="label">Views</span>
                </span>
                <button type="button" class="stat-item like-container like-button" data-like-button data-post-id="<%= publication.id %>" aria-pressed="<%= locals.liked ? 'true' : 'false' %>" aria-label="Like this publication">
                    <span class="icon<%= locals.liked ? ' liked' : '' %>" id="likeIcon"><%- icon('heart') %></span>
                    <span class="count" id="likeCount" data-like-count><%= publication.likes || 0 %></span>
                    <span class="label">Likes</span>
                </button>
                <span class="stat-item">
                    <span class="icon"><%- icon('file-text') %></span>
                    <span class="count"><%= publication.read_time || '5 min' %></span>
                    <span class="label">Read Time</span>
                </span>
                <% if (details.pdf_url) { %>
                    <a class="stat-item pdf-download" href="<%= details.pdf_url %>" target="_blank" rel="noopener noreferrer">
                        <span class="icon"><%- icon('file-text') %></span>
                        <span class="label">Download PDF</span>
                    </a>
                    <button type="button" class="stat-item pdf-preview-toggle" id="pdfPreviewToggle" aria-expanded="false" aria-controls="pdfPreviewFrame">
                        <span class="icon"><%- icon('eye') %></span>
                        <span class="label">Preview PDF</span>
                    </button>
                <% } %>
            </div>
        </div>

        <% if (details.pdf_url) { %>
            <div id="pdfPreviewWrap" class="pdf-preview-wrap" hidden>
                <iframe id="pdfPreviewFrame" class="pdf-preview-frame" title="PDF preview" src="" loading="lazy"></iframe>
            </div>
        <% } %>

        <!-- Abstract -->
        <section class="journal-section abstract-box">
            <h2>Abstract</h2>
            <p><%= details.abstract || publication.excerpt || 'No abstract available.' %></p>
            <% if (details.keywords && details.keywords.length) { %>
                <div class="keyword-chips">
                    <span class="keyword-label">Keywords:</span>
                    <% details.keywords.forEach((kw) => { %>
                        <span class="keyword-chip"><%= kw %></span>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <!-- Full text -->
        <div class="publication-content">
            <%- include('../partials/content-blocks', { sections: publication.content && publication.content.sections }) %>
        </div>

        <!-- References -->
        <% if (details.reference_list && details.reference_list.length) { %>
            <section class="publication-references">
                <h2>References</h2>
                <ol>
                    <% details.reference_list.forEach((ref) => { %>
                        <li>
                            <span class="ref-text"><%= ref.text %></span>
                            <% if (ref.url) { %>
                                <a href="<%= ref.url %>" target="_blank" rel="noopener noreferrer">[Link]</a>
                            <% } %>
                        </li>
                    <% }) %>
                </ol>
            </section>
        <% } %>

        <!-- Cite this article -->
        <section class="journal-section cite-box">
            <h2>Cite this article</h2>
            <p id="citationText" class="citation-text"><%= citation %></p>
            <div class="cite-actions">
                <button type="button" class="btn-sm" id="copyCitationBtn"><%- icon('link') %> Copy citation</button>
                <a class="btn-sm" href="/publications/<%= publication.slug %>/cite.bib">Download BibTeX</a>
                <a class="btn-sm" href="/publications/<%= publication.slug %>/cite.ris">Download RIS</a>
                <% if (details.doi) { %>
                    <a class="btn-sm" href="https://doi.org/<%= details.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '') %>" target="_blank" rel="noopener noreferrer">View at DOI</a>
                <% } %>
            </div>
            <p class="license-line"><%= details.license || 'All rights reserved' %></p>
        </section>

        <!-- Social Share -->
        <%- include('../components/social-share', { 
            url: canonicalUrl || '',
            title: publication.title
        }) %>

        <!-- Related Publications -->
        <%- include('../components/related-posts', { 
            posts: relatedPublications || [],
            type: 'publications'
        }) %>

        <!-- Comments -->
        <%- include('../components/comments', { 
            postId: publication.id,
            comments: comments || []
        }) %>
    </article>
</div>

<script>
    document.getElementById('copyCitationBtn')?.addEventListener('click', function () {
        var text = document.getElementById('citationText').textContent;
        var btn = this;
        navigator.clipboard.writeText(text).then(function () {
            var original = btn.innerHTML;
            btn.textContent = 'Copied';
            setTimeout(function () { btn.innerHTML = original; }, 1800);
        }).catch(function () { /* clipboard permission denied; nothing to fall back to safely */ });
    });

    // The PDF is only loaded into the iframe once the visitor asks to see
    // it, so a page with a large PDF attached does not fetch it up front.
    (function () {
        var toggle = document.getElementById('pdfPreviewToggle');
        var wrap = document.getElementById('pdfPreviewWrap');
        var frame = document.getElementById('pdfPreviewFrame');
        if (!toggle || !wrap || !frame) return;

        toggle.addEventListener('click', function () {
            var isOpen = !wrap.hidden;
            if (isOpen) {
                wrap.hidden = true;
                toggle.setAttribute('aria-expanded', 'false');
                toggle.querySelector('.label').textContent = 'Preview PDF';
            } else {
                if (!frame.src) frame.src = <%- JSON.stringify(details.pdf_url || '') %>;
                wrap.hidden = false;
                toggle.setAttribute('aria-expanded', 'true');
                toggle.querySelector('.label').textContent = 'Hide preview';
            }
        });
    })();
</script>
<script src="/js/engagement.js" defer></script>
