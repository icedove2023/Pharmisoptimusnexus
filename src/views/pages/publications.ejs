<!-- src/views/pages/publications.ejs -->
<div class="journal-index-hero">
    <div class="journal-index-hero-inner">
        <span class="journal-index-eyebrow">Pharmis Optimus Nexus &middot; Journal</span>
        <h1>Publications</h1>
        <p>Peer-reviewed research, clinical studies, and review articles from our global network of researchers.</p>
    </div>
</div>

<!-- Filters -->
<div class="filters-bar">
    <div class="search-input-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="pubSearch" placeholder="Search publications..." aria-label="Search publications" value="<%= locals.currentSearch || '' %>" />
    </div>
    <select class="filter-select" id="pubCategoryFilter">
        <option value="">All Categories</option>
        <% (categories || []).forEach((c) => { %>
            <option value="<%= c.name %>"<%= currentCategory === c.name ? ' selected' : '' %>><%= c.name %> (<%= c.count %>)</option>
        <% }) %>
    </select>
    <% if (years && years.length) { %>
        <select class="filter-select" id="pubYearFilter">
            <option value="">All Years</option>
            <% years.forEach((y) => { %>
                <option value="<%= y %>"<%= locals.currentYear === String(y) ? ' selected' : '' %>><%= y %></option>
            <% }) %>
        </select>
    <% } %>
</div>

<div class="journal-index">
    <% if (publications && publications.length) { %>
        <ol class="journal-index-list">
            <% publications.forEach((pub) => { %>
                <li class="journal-index-entry">
                    <div class="entry-meta-col">
                        <span class="entry-type"><%= pub.articleType || pub.category || 'Publication' %></span>
                        <span class="entry-date"><%- icon('calendar') %> <%= pub.published_date %></span>
                        <% if (pub.volume) { %>
                            <span class="entry-volume">Vol. <%= pub.volume %><% if (pub.issue) { %>, Issue <%= pub.issue %><% } %></span>
                        <% } %>
                    </div>
                    <div class="entry-main">
                        <h2><a href="/publications/<%= pub.slug || pub.id %>"><%= pub.title %></a></h2>
                        <p class="entry-authors">
                            <%- icon('users') %>
                            <%= pub.authorList && pub.authorList.length ? pub.authorList.map(a => a.name).join(', ') : pub.authors.join(', ') %>
                        </p>
                        <p class="entry-abstract"><%= pub.abstract || 'No abstract available.' %></p>
                        <div class="entry-footer">
                            <% if (pub.doi) { %>
                                <span class="entry-doi">DOI: <%= pub.doi %></span>
                            <% } %>
                            <a href="/publications/<%= pub.slug || pub.id %>" class="btn-sm">Read article &rarr;</a>
                        </div>
                    </div>
                </li>
            <% }) %>
        </ol>
    <% } else { %>
        <p class="journal-index-empty">No publications found.</p>
    <% } %>

    <!-- Pagination -->
    <%- include('../partials/pagination', { 
        pagination: pagination,
        baseUrl: '/publications?'
    }) %>
</div>

<script>
    // Search filter
    document.getElementById('pubSearch')?.addEventListener('input', function() {
        const searchTimeout = this.dataset.timeout;
        clearTimeout(searchTimeout);
        
        const newTimeout = setTimeout(() => {
            const query = this.value.trim();
            const url = new URL(window.location.href);
            if (query) {
                url.searchParams.set('search', query);
            } else {
                url.searchParams.delete('search');
            }
            window.location.href = url.toString();
        }, 500);
        
        this.dataset.timeout = newTimeout;
    });
    
    // Category filter
    document.getElementById('pubCategoryFilter')?.addEventListener('change', function() {
        const category = this.value;
        const url = new URL(window.location.href);
        if (category) {
            url.searchParams.set('category', category);
        } else {
            url.searchParams.delete('category');
        }
        window.location.href = url.toString();
    });

    // Year filter
    document.getElementById('pubYearFilter')?.addEventListener('change', function() {
        const year = this.value;
        const url = new URL(window.location.href);
        if (year) {
            url.searchParams.set('year', year);
        } else {
            url.searchParams.delete('year');
        }
        window.location.href = url.toString();
    });
</script>
