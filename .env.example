# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Admin area URL. Not linked from the site — admins open this address directly.
# Pick something only your team knows, e.g. /nx-admin-7f2.
ADMIN_PATH=/studio

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Session cookie signing. Generate with: node scripts/generate-secret.js
# Required in production: the server refuses to start without it.
SESSION_SECRET=

# Email (Gmail app password or any SMTP provider)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Pharmis Optimus Nexus
CONTACT_EMAIL=
NOTIFICATION_EMAIL=
TEST_EMAIL=
